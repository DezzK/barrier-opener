    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M18,80 L34,80 L36,86 L16,86 Z"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M23,44 L29,44 L29,80 L23,80 Z"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M26,40 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#FFFFFFFF" />

    <group
        android:pivotX="26"
        android:pivotY="44"
        android:rotation="-10">
        <path
            android:pathData="M26,44 L84,44 L84,56 L26,56 Z"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>
