        <path
            android:pathData="M122,40 L134,40 L128,56 L116,56 Z"
            android:fillColor="#1F2128" />
        <path
            android:pathData="M146,40 L158,40 L152,56 L140,56 Z"
            android:fillColor="#1F2128" />

        <!-- Red tip cap -->
        <path
            android:pathData="M162,40 L166,40 L166,56 L162,56 Z"
            android:fillColor="#D93025" />
    </group>
</vector>
