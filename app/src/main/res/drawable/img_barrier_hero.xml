        android:fillColor="#3C4043" />

    <!-- Vertical pole -->
    <path
        android:pathData="M29,42 L37,42 L37,98 L29,98 Z"
        android:fillColor="#3C4043" />

    <!-- Pole top knob -->
    <path
        android:pathData="M33,38 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
        android:fillColor="#3C4043" />

    <!-- Boom raised -->
    <group
        android:pivotX="33"
        android:pivotY="42"
        android:rotation="-15">

        <!-- Outline -->
        <path
            android:pathData="M30,38 L168,38 L168,58 L30,58 Z"
            android:fillColor="#1F2128" />

        <!-- Yellow body -->
        <path
            android:pathData="M32,40 L166,40 L166,56 L32,56 Z"
            android:fillColor="#FFD400" />

        <!-- Diagonal stripes -->
        <path
            android:pathData="M50,40 L62,40 L56,56 L44,56 Z"
            android:fillColor="#1F2128" />
        <path
            android:pathData="M74,40 L86,40 L80,56 L68,56 Z"
