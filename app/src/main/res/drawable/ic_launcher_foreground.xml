<!--
  Adaptive icon foreground. Viewport 108x108, but every launcher mask trims down to roughly
  the central 66x66 (x=21..87, y=21..87). All composition stays inside that region.

  Layout:
    pole at the left of the safe area, boom raised to the right at -10°.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pole base plate -->
    <path
        android:pathData="M18,80 L34,80 L36,86 L16,86 Z"
        android:fillColor="#E8EAED" />

    <!-- Vertical pole -->
    <path
        android:pathData="M23,44 L29,44 L29,80 L23,80 Z"
        android:fillColor="#E8EAED" />

    <!-- Pole top knob -->
    <path
        android:pathData="M26,40 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#E8EAED" />

    <!-- Boom group: pre-rotation, the boom is a horizontal yellow bar attached to the pole top.
         Rotating -10° lifts the free end up-and-to-the-right. Pivot at the boom's left-center
         where it meets the pole. -->
    <group
        android:pivotX="26"
        android:pivotY="44"
        android:rotation="-10">

        <!-- Subtle dark outline for contrast against yellow -->
        <path
            android:pathData="M24,42 L86,42 L86,58 L24,58 Z"
            android:fillColor="#1F2128" />

        <!-- Boom body -->
        <path
            android:pathData="M26,44 L84,44 L84,56 L26,56 Z"
            android:fillColor="#FFD400" />

        <!-- Diagonal warning stripes, slanted parallelograms -->
        <path
            android:pathData="M36,44 L44,44 L40,56 L32,56 Z"
            android:fillColor="#1F2128" />
        <path
            android:pathData="M52,44 L60,44 L56,56 L48,56 Z"
            android:fillColor="#1F2128" />
        <path
            android:pathData="M68,44 L76,44 L72,56 L64,56 Z"
            android:fillColor="#1F2128" />

        <!-- Red tip cap on the free end -->
        <path
            android:pathData="M80,44 L84,44 L84,56 L80,56 Z"
            android:fillColor="#D93025" />
    </group>
</vector>
